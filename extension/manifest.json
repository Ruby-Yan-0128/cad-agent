{
  "manifest_version": 3,
  "name": "CAD Agent",
  "version": "0.1.0",
  "description": "Local build123d CAD runner and viewer",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Open CAD Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}